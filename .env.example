# Supabase project — copy to .env and fill in real values
SUPABASE_URL=https://oynfhdqizebvgmaoiuax.supabase.co
SUPABASE_ANON_KEY=

# Mode: 'live' | 'demo'
#   live → talks to Supabase. Demo rows are still shown until first real row arrives per investor.
#   demo → never talks to Supabase. Useful for design review / disconnected dev.
ARL_APP_MODE=live

# Zoho OAuth — only used if you wire the (currently stubbed) Zoho-OAuth login path.
# Decision #1 in the backend doc says we use Supabase email invite, so leaving this empty is fine.
ZOHO_CLIENT_ID=
ZOHO_REDIRECT_URI=com.arl.app://auth

# Sentry crash reporting (EU region project "growize-investor-portal").
# Read at COMPILE TIME via `flutter build ... --dart-define-from-file=.env.production`,
# NOT bundled as a runtime asset. Leaving SENTRY_DSN empty disables Sentry entirely.
# Do not commit a real DSN value here — fill it in .env.production locally / in CI.
SENTRY_DSN=

# One of: production | staging | dev. Tags every event so dashboards can filter.
SENTRY_ENVIRONMENT=dev

# Set per build, e.g. `growize@1.0.0+1`. Used by Sentry to group events by release.
SENTRY_RELEASE=unset
