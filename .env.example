# Supabase project — copy to .env and fill in real values
SUPABASE_URL=https://oynfhdqizebvgmaoiuax.supabase.co
SUPABASE_ANON_KEY=

# Mode: 'live' | 'demo'
#   live → talks to Supabase. Demo rows are still shown until first real row arrives per investor.
#   demo → never talks to Supabase. Useful for design review / disconnected dev.
ARL_APP_MODE=live

# Zoho OAuth — only used if you wire the (currently stubbed) Zoho-OAuth login path.
# Decision #1 in the backend doc says we use Supabase email invite, so leaving this empty is fine.
ZOHO_CLIENT_ID=
ZOHO_REDIRECT_URI=com.arl.app://auth
