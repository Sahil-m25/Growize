# Growize / ARL Investor Portal — environment file template.
#
# Copy this file to `.env.production` (gitignored) and fill in real values,
# then run with:
#
#   flutter run --dart-define-from-file=.env.production
#   flutter build web --release --dart-define-from-file=.env.production
#   flutter build apk --release --dart-define-from-file=.env.production
#
# Never commit `.env.production` or any file containing real credentials.

# ── Supabase ─────────────────────────────────────────────────────────
# Public anon (publishable) key — safe to ship to the client. The
# Supabase URL is not a secret either, but treat both as deployment
# configuration rather than source-controlled constants.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=

# ── App mode ─────────────────────────────────────────────────────────
# `live` → talks to Supabase. Demo rows are shown until the first real
#          row arrives per investor.
# `demo` → never talks to Supabase. Useful for design review.
ARL_APP_MODE=live

# ── Dev-only flags ───────────────────────────────────────────────────
# Bypass auth gate in debug builds only — release builds force this to
# false regardless of the value. Only set this in `.env.local` for dev.
ARL_DEV_BYPASS=false
