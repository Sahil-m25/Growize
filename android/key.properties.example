# Android release-signing credentials. Copy to `key.properties` (gitignored)
# and fill in real values. The Flutter Gradle build reads this file at
# configure time — see android/app/build.gradle.kts.
#
# storeFile is resolved relative to android/app/, so a value like
# `arl-release-key.jks` points at android/app/arl-release-key.jks.
#
# Generate the keystore once with:
#   keytool -genkey -v -keystore arl-release-key.jks \
#           -keyalg RSA -keysize 2048 -validity 10000 \
#           -alias arl-release
# Move the resulting .jks into android/app/ and back it up off-device.
# Losing the keystore means you can never push a signed update of this
# package name again, so commit the .jks to a secure password manager
# vault, not to git.

storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=arl-release
storeFile=arl-release-key.jks
