<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme: shown while the process starts, removed on the first
         Flutter frame. Brand cream in both light and dark mode so there is
         no black/white flash before the Flutter BrandSplash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window colour behind the Flutter UI while it initialises. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
