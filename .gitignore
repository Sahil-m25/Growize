#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets / env
.env
.env.local
.env.*.local
.env.production
.env.staging
supabase/.env
supabase/.env.local
supabase/.branches/
supabase/.temp/

# Android release signing (do not commit)
android/key.properties
android/app/arl-release-key.jks
android/app/*.jks

# iOS distribution (do not commit)
ios/ExportOptions.plist
ios/exportOptions.plist
ios/Runner/GoogleService-Info.plist
*.mobileprovision
*.p12
*.p8
*.cer
*.certSigningRequest

# Office / editor lock files
.~lock.*#

# Local CLI capture output
analyze_output.txt
flutter_output.txt
.tmp_tools/
